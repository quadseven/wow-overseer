# Settings the seed step reads from its environment (python3 -m ephemeral seed).
# Every value here is a placeholder. In a world pod they come from the pod spec,
# never from a decree and never from a file in this repository.
#
# Must be the loopback address; the guard refuses anything else.
EPH_MYSQL_HOST=127.0.0.1
# Must be the world's own MySQL port; the guard refuses any other.
EPH_MYSQL_PORT=3306
EPH_MYSQL_USER=YOUR_DB_USER_HERE
# The world's own random password, generated when the pod starts.
EPH_MYSQL_PASSWORD=YOUR_DB_PASSWORD_HERE
# The namespace's world label value; must be exactly: ephemeral
EPH_WORLD_LABEL=ephemeral
# The harness ConfigMap's grants line; must be exactly: grants: enabled
EPH_HARNESS_GRANTS=grants: enabled
