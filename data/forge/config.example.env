# Configuration read by `python -m forge build`. Copy to a private file, fill in
# your own values and export them. Nothing here is a real name or address.

# Registry path the template image is pushed to (no scheme, no tag). The image
# is named wow-eph-template:<class>-<stamp> under it.
FORGE_REGISTRY=registry.example.invalid/ephemeral

# File name prefix of the nightly dumps on the backup share. The forge restores
# the newest <prefix>-<stamp>.sql.gz, where <stamp> looks like 20260101T050000Z.
FORGE_BACKUP_PREFIX=example-characters
