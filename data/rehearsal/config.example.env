# Settings the rehearsal harness reads from its environment.
# Every value here is a placeholder. In a world pod they come from the pod spec,
# never from a decree and never from a file in this repository.
#
# Must be the loopback address; the guard refuses anything else.
REHEARSAL_MYSQL_HOST=127.0.0.1
# Must be the world's own MySQL port; the guard refuses any other.
REHEARSAL_MYSQL_PORT=3306
REHEARSAL_MYSQL_USER=YOUR_DB_USER_HERE
# The world's own random password, generated when the pod starts.
REHEARSAL_MYSQL_PASSWORD=YOUR_DB_PASSWORD_HERE
# The namespace's world label value; must be exactly: rehearsal
REHEARSAL_WORLD_LABEL=rehearsal
# The harness ConfigMap's grants line; must be exactly: grants: enabled
REHEARSAL_GRANTS_ENABLED=grants: enabled
# Shared by the seed (writes it) and the judge (reads it): the decree's variables and resolved cast.
REHEARSAL_VARS_FILE=/work/handoff.json
# The judge's worldserver log: REHEARSAL_LOG_FILE is the file itself; otherwise the judge reads Module.log
# inside REHEARSAL_LOGS_DIR (the log directory the pod mounts). --log overrides both.
REHEARSAL_LOGS_DIR=/work/logs
REHEARSAL_LOG_FILE=/work/logs/Module.log
# A bridge-on decree also reads the bridge sidecar's log: REHEARSAL_BRIDGE_LOG_FILE, else Bridge.log in REHEARSAL_LOGS_DIR.
REHEARSAL_BRIDGE_LOG_FILE=/work/logs/Bridge.log
# The judge only. Names this run and its arm in the result ConfigMap rehearsal-result-<run id>.
REHEARSAL_RUN_ID=YOUR_RUN_ID_HERE
REHEARSAL_ARM=control
# The judge only: how long it polls the start preconditions for the family to log in (seconds, default 600).
REHEARSAL_START_WAIT_SECONDS=600
# The namespace the result ConfigMap is created in (defaults to the pod's own).
REHEARSAL_NAMESPACE=YOUR_WORLD_NAMESPACE_HERE
# The judge also reads KUBERNETES_SERVICE_HOST and KUBERNETES_SERVICE_PORT, which the cluster sets in every pod.
# The PC-side runner commands (submit, dispatch, collect) read their settings file from here.
# See rehearsal/rehearsal.config.example.json for its keys.
REHEARSAL_CONFIG=/path/to/rehearsal.config.json
# `dispatch` records its owner in a local lock file (default: ~/.rehearsal/dispatch.lock).
REHEARSAL_LOCK=/path/to/dispatch.lock
# Who owns this dispatcher; `dispatch --stop` only stops the matching owner (default: the parent pid).
REHEARSAL_OWNER=YOUR_AGENT_NAME_HERE
