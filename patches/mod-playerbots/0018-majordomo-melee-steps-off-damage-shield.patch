diff --git a/src/Ai/Raid/MC/MCMultipliers.cpp b/src/Ai/Raid/MC/MCMultipliers.cpp
index 0000000..0000000 100644
--- a/src/Ai/Raid/MC/MCMultipliers.cpp
+++ b/src/Ai/Raid/MC/MCMultipliers.cpp
@@ -162,3 +162,25 @@ float MajordomoReflectionMultiplier::GetValue(Action* action)
                     " casters holding, magic reflection on " + target->GetName());
     return 0.0f;
 }
+
+// Majordomo's Damage Shield reflects melee damage back at the attacker.
+// While an add carries the shield, melee step off it and retarget an
+// unshielded add.
+float MajordomoDamageShieldMultiplier::GetValue(Action* action)
+{
+    if (!PlayerbotAI::IsMelee(bot))
+        return 1.0f;
+
+    // Only melee swings trigger the damage shield.
+    if (!dynamic_cast<MeleeAction*>(action))
+        return 1.0f;
+
+    Unit* target = AI_VALUE(Unit*, "current target");
+    if (!target || !target->IsInWorld())
+        return 1.0f;
+
+    // The shield is on Majordomo and his Flamewaker adds.
+    if (target->GetEntry() != NPC_MAJORDOMO_EXECUTUS &&
+        target->GetEntry() != NPC_FLAMEWAKER_HEALER &&
+        target->GetEntry() != NPC_FLAMEWAKER_ELITE)
+        return 1.0f;
+
+    if (!target->HasAura(SPELL_DAMAGE_SHIELD))
+        return 1.0f;
+
+    return 0.0f;
+}
