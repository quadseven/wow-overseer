 // Shazzrah's Arcane Explosion radius
 constexpr float ARCANE_EXPLOSION_DISTANCE = 26.0f;
+
+// Dark Mending is interrupted by exactly this many bots, no more, no fewer
+constexpr uint32 DARK_MENDING_INTERRUPTER_COUNT = 2;
+
+// The healer that follows a Living Bomb carrier stays this close, which is
+// outside the bomb's blast and inside healing range
+constexpr float LIVING_BOMB_FOLLOW_DISTANCE = 25.0f;
+
+// Classes with a reliable interrupt of their own. Warlock (needs a felhunter)
+// and hunter (talent) are left out so an assignment is never wasted.
+inline bool CanInterruptCasts(Player* player)
+{
+    switch (player->getClass())
+    {
+        case CLASS_WARRIOR:
+        case CLASS_ROGUE:
+        case CLASS_MAGE:
+        case CLASS_SHAMAN:
+            return true;
+        default:
+            return false;
+    }
+}
+
+// The two assigned interrupters are the two living members with an interrupt
+// and the lowest guids in the group. The rule is the same on every bot, so
+// the bots agree without talking to each other.
+inline bool IsDarkMendingInterrupter(Player* bot)
+{
+    if (!CanInterruptCasts(bot))
+        return false;
+
+    Group* group = bot->GetGroup();
+    if (!group)
+        return true;
+
+    uint32 ahead = 0;
+    for (GroupReference* ref = group->GetFirstMember(); ref; ref = ref->next())
+    {
+        Player* member = ref->GetSource();
+        if (!member || member == bot || !member->IsAlive() || member->GetMapId() != bot->GetMapId() ||
+            !CanInterruptCasts(member))
+            continue;
+        if (member->GetGUID().GetCounter() < bot->GetGUID().GetCounter())
+            ++ahead;
+    }
+    return ahead < DARK_MENDING_INTERRUPTER_COUNT;
+}
+
+// The bomb carrier this bot must follow, or null. Exactly one healer, the
+// living one with the lowest guid that is not carrying a bomb, follows the
+// carrier. Nobody else is given a reason to leave the group.
+inline Player* LivingBombFollowTarget(Player* bot)
+{
+    Group* group = bot->GetGroup();
+    if (!group || !PlayerbotAI::IsHeal(bot) || bot->HasAura(SPELL_LIVING_BOMB))
+        return nullptr;
+
+    Player* carrier = nullptr;
+    Player* follower = nullptr;
+    for (GroupReference* ref = group->GetFirstMember(); ref; ref = ref->next())
+    {
+        Player* member = ref->GetSource();
+        if (!member || !member->IsAlive() || member->GetMapId() != bot->GetMapId())
+            continue;
+        if (member->HasAura(SPELL_LIVING_BOMB))
+        {
+            if (!carrier)
+                carrier = member;
+        }
+        else if (PlayerbotAI::IsHeal(member) &&
+                 (!follower || member->GetGUID().GetCounter() < follower->GetGUID().GetCounter()))
+            follower = member;
+    }
+    return carrier && follower == bot ? carrier : nullptr;
+}
 }
 
 #endif
