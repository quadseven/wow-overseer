--- a/src/Ai/Raid/MC/MCMultipliers.cpp
+++ b/src/Ai/Raid/MC/MCMultipliers.cpp
@@ -120,3 +120,43 @@ float GolemaggMultiplier::GetValue(Action* action)
         if (!burnPhase && !PlayerbotAI::IsTank(bot) && backedOff && engagesBoss)
             return 0.0f;
     }
     return 1.0f;
 }
+
+// Majordomo's Magic Reflection sends a caster's own spell back at them.
+// While an add carries the reflection, casters hold their spells on it
+// and switch to an unshielded target, or wand or wait.
+float MajordomoReflectionMultiplier::GetValue(Action* action)
+{
+    if (!PlayerbotAI::IsCaster(bot))
+        return 1.0f;
+
+    // Only spell casts can break the reflection shield.
+    if (!dynamic_cast<CastSpellAction*>(action))
+        return 1.0f;
+
+    Unit* target = AI_VALUE(Unit*, "current target");
+    if (!target || !target->IsInWorld())
+        return 1.0f;
+
+    // The shield is on Majordomo and his Flamewaker adds.
+    if (target->GetEntry() != NPC_MAJORDOMO_EXECUTUS &&
+        target->GetEntry() != NPC_FLAMEWAKER_HEALER &&
+        target->GetEntry() != NPC_FLAMEWAKER_ELITE)
+        return 1.0f;
+
+    if (!target->HasAura(SPELL_MAGIC_REFLECTION))
+        return 1.0f;
+
+    int holding = 0;
+    if (Group* group = bot->GetGroup())
+    {
+        for (GroupReference* itr = group->GetFirstMember(); itr; itr = itr->next())
+        {
+            Player* member = itr->GetSource();
+            if (member && member->IsAlive() && PlayerbotAI::IsCaster(member))
+                ++holding;
+        }
+    }
+    if (!holding)
+        holding = 1;
+
+    botAI->TellError("[MC] majordomo: " + std::to_string(holding) +
+                     " casters holding, magic reflection on " + target->GetName());
+    return 0.0f;
+}
