From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: wow-overseer <noreply@example.com>
Date: Thu, 26 Nov 2026 00:00:00 +0000
Subject: [PATCH] Prune guild advertisements from ai_playerbot_texts

---
 data/sql/playerbots/updates/2026_11_10_00_ai_playerbot_guild_ads.sql | 12 ++++++++++++
 1 file changed, 12 insertions(+)
 create mode 100644 data/sql/playerbots/updates/2026_11_10_00_ai_playerbot_guild_ads.sql

diff --git a/data/sql/playerbots/updates/2026_11_10_00_ai_playerbot_guild_ads.sql b/data/sql/playerbots/updates/2026_11_10_00_ai_playerbot_guild_ads.sql
new file mode 100644
index 0000000..1111111
--- /dev/null
+++ b/data/sql/playerbots/updates/2026_11_10_00_ai_playerbot_guild_ads.sql
@@ -0,0 +1,12 @@
+-- Prune guild advertisements from generic suggestions (#1640).
+--
+-- Bots that already belong to a guild must not advertise for one, and no
+-- suggest_something line may assert a guild state the speaker may not be in.
+DELETE FROM `ai_playerbot_texts` WHERE `id` IN (741, 743);
+
+-- Any other suggest_something line that advertises for a guild.
+DELETE FROM `ai_playerbot_texts`
+ WHERE `name` = 'suggest_something'
+   AND (`text` LIKE '%looking for guild%'
+     OR `text` LIKE '%join a good guild%'
+     OR `text` LIKE '%looking for a guild%');
