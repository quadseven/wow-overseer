diff --git a/src/Ai/Raid/MC/MCMultipliers.cpp b/src/Ai/Raid/MC/MCMultipliers.cpp
index 0000000..0000000 100644
--- a/src/Ai/Raid/MC/MCMultipliers.cpp
+++ b/src/Ai/Raid/MC/MCMultipliers.cpp
@@ -186,3 +186,35 @@ float MajordomoDamageShieldMultiplier::GetValue(Action* action)
     if (!target->HasAura(SPELL_DAMAGE_SHIELD))
         return 1.0f;
 
     return 0.0f;
 }
+
+// Teleport Target throws the tank into the fire pit, dropping threat on the
+// adds it held. Once the aura clears and the tank is back, re-establish
+// threat on the held adds.
+float MajordomoReTauntMultiplier::GetValue(Action* action)
+{
+    if (!PlayerbotAI::IsTank(bot))
+        return 1.0f;
+
+    // While the tank is being ported to the pit it cannot act; re-taunt once
+    // Teleport Target has cleared and the tank is back with the adds.
+    if (bot->HasAura(SPELL_TELEPORT_TARGET))
+        return 1.0f;
+
+    Unit* target = AI_VALUE(Unit*, "current target");
+    if (!target || !target->IsInWorld())
+        return 1.0f;
+
+    // The held adds are the Flamewaker healers and elites.
+    if (target->GetEntry() != NPC_FLAMEWAKER_HEALER && target->GetEntry() != NPC_FLAMEWAKER_ELITE)
+        return 1.0f;
+
+    // Re-taunt the add: prioritize attack and melee on the held add.
+    if (dynamic_cast<AttackAction*>(action) || dynamic_cast<MeleeAction*>(action))
+        return 2.0f;
+
+    return 1.0f;
+}
diff --git a/src/Ai/Raid/MC/MCStrategy.cpp b/src/Ai/Raid/MC/MCStrategy.cpp
index 0000000..0000000 100644
--- a/src/Ai/Raid/MC/MCStrategy.cpp
+++ b/src/Ai/Raid/MC/MCStrategy.cpp
@@ -94,6 +94,7 @@ void RaidMcStrategy::InitMultipliers(std::vector<Multiplier*>& multipliers)
     multipliers.push_back(new GolemaggMultiplier(botAI));
     multipliers.push_back(new MajordomoReflectionMultiplier(botAI));
     multipliers.push_back(new MajordomoDamageShieldMultiplier(botAI));
+    multipliers.push_back(new MajordomoReTauntMultiplier(botAI));
 }
 
 void RaidMcStrategy::AppendTargetExclusions(GuidSet& exclusions, TargetValueExclusionType type)
@@ -121,6 +122,20 @@ void RaidMcStrategy::AppendTargetExclusions(GuidSet& exclusions, TargetValueExclusionType type)
         if ((golemaggAlive && unit->GetEntry() == NPC_CORE_RAGER) || unit->GetEntry() == NPC_MAJORDOMO_EXECUTUS)
             exclusions.insert(guid);
     }
+
+    // Kill order: Flamewaker healers are the skull target and die first.
+    // While a healer is alive, elites are excluded from DPS/attacker target
+    // selection so the party burns the healers before the elites.
+    bool healerAlive = false;
+    for (ObjectGuid const guid : AI_VALUE(GuidVector, "attackers"))
+    {
+        Unit* unit = botAI->GetUnit(guid);
+        if (!unit)
+            continue;
+        if (unit->GetEntry() == NPC_FLAMEWAKER_HEALER)
+            healerAlive = true;
+    }
+    if (healerAlive)
+    {
+        for (ObjectGuid const guid : AI_VALUE(GuidVector, "attackers"))
+        {
+            Unit* unit = botAI->GetUnit(guid);
+            if (!unit)
+                continue;
+            if (unit->GetEntry() == NPC_FLAMEWAKER_ELITE)
+                exclusions.insert(guid);
+        }
+    }
 }
 
 bool RaidMcStrategy::HasTargetExclusions() const { return true; }
