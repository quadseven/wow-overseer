# Optional switches of the bridge. Every key is shown with its default; set one
# only to change it. The bridge reads the process environment (a deployment
# sets these on its container), so this file is a reference, not a loader.

# enchant-for: whether the bridge asks a guild's enchanters to enchant a
# member's worn piece through a trade window. "on" is the default; "off", "0",
# "false" or "no" disables the pass. Whatever this says, nothing is written
# until the worldserver module reports that it answers the verb.
ENCHANT_FOR=on

# door quorum on the readiness card: the seats, tanks and healers the module
# holds a raid at the door for. Set all three to the worldserver's
# Overseer.Raid.QuorumSeats, QuorumTanks and QuorumHealers when the realm
# overrides them; unset, the card shows the module defaults and says so.
# RAID_DOOR_QUORUM_SEATS=36
# RAID_DOOR_QUORUM_TANKS=3
# RAID_DOOR_QUORUM_HEALERS=8
