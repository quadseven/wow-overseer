# Every variable strands_server.py reads, with its default. Copy, edit, and
# pass with `docker run --env-file`.
BIND=127.0.0.1
PORT=8790
# library (the real model) or fake (no model, for smoke tests only)
STRANDS_DECIDER=library
# A Hugging Face model id or a local checkpoint folder
STRANDS_CHECKPOINT=StrandsAgents/strands-decider-2B-qwen3.5-v1-2610
# cpu, cuda, mps or mlx (the image ships CPU torch only)
STRANDS_DEVICE=cpu
# The model id answers carry; empty means the checkpoint's last path segment
STRANDS_MODEL_NAME=
STRANDS_MAX_BODY_BYTES=1048576
# Where the weights are downloaded and cached
HF_HOME=/models
